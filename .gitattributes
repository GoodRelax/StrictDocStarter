# Auto detect text files and perform LF normalization
* text=auto

# Check every Markdown file out with LF, on every platform.
#
# The specification samples are shipped in a shape a Markdown formatter has
# nothing to say about, so that a reader who opens a file and saves it sees no
# diff at all. Line endings are part of that shape: Prettier writes LF by
# default, so identical content fails `prettier --check` for no reason other
# than being CRLF (measured on 3.5.3 - the same 44 lines pass as LF and fail as
# CRLF). Without this line the samples could never be a formatting fixed point
# on Windows, however carefully they were written.
#
# This costs the reader nothing. The index already holds LF, so pinning the
# working tree to LF produces no diff and no re-commit; it only decides which
# bytes a checkout writes. Windows scripts are deliberately not listed here -
# .bat and .ps1 keep the CRLF they need.
*.md text eol=lf

# Keep the download to what a user actually opens.
#
# README tells a newcomer to download the ZIP that GitHub builds from this
# branch, unzip it and double-click. Everything that lands in that folder is
# something they have to look at and decide to ignore, so the two directories
# below are cut from the archive. They stay in the repository, where they
# belong -- export-ignore only affects `git archive`, which is what GitHub
# serves for /archive/refs/heads/main.zip.
#
# tools/, docs/ and claude-skills/ deliberately stay in: README links to all
# three, so a reader who follows those links must find them in the download.
vm-tests/ export-ignore
.github/ export-ignore
